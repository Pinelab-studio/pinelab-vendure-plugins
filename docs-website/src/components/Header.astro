---
import DefaultHeader from '@astrojs/starlight/components/Header.astro';

const links = [
  { label: 'Plugins', href: '/#plugins' },
  { label: 'Recipes', href: '/#recipes' },
  { label: 'AI integration', href: '/ai-integration/' },
  { label: 'Contact', href: 'https://pinelab.studio/contact/' },
];
const pathname = Astro.url.pathname;
---

<div class="pinelab-header">
  <div class="built-in-header"><DefaultHeader><slot /></DefaultHeader></div>
  <nav aria-label="Main navigation">
    {
      links.map(({ label, href }) => (
        <a
          href={href}
          aria-current={
            href.startsWith('/') &&
            !href.includes('#') &&
            pathname.startsWith(href)
              ? 'page'
              : undefined
          }
        >
          {label}
        </a>
      ))
    }
  </nav>
</div>

<style>
  .pinelab-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 100%;
  }
  .built-in-header {
    flex: 1;
    min-width: 0;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  nav a {
    color: var(--sl-color-text);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  nav a:hover,
  nav a[aria-current] {
    color: var(--sl-color-text-accent);
  }
  @media (max-width: 64rem) {
    nav {
      display: none;
    }
  }
</style>
