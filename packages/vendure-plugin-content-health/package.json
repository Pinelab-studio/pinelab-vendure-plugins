{
  "name": "@pinelab/vendure-plugin-content-health",
  "version": "0.2.0",
  "description": "Vendure plugin that validates product and collection storefront pages for SEO/content issues (meta tags, hreflang, JSON-LD, sitemap inclusion) and surfaces the results in the dashboard.",
  "keywords": [
    "vendure",
    "seo",
    "content",
    "hreflang",
    "sitemap",
    "structured data",
    "monitoring"
  ],
  "author": "LazyClicks",
  "homepage": "https://plugins.pinelab.studio/",
  "repository": "https://github.com/Pinelab-studio/pinelab-vendure-plugins",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsc && copyfiles -u 1 'src/dashboard/**/*' dist/ && yarn build:dashboard",
    "build:dashboard": "vite build --config ./vite.config.mts",
    "dev:dashboard": "vite --clearScreen false",
    "start": "ts-node test/dev-server.ts",
    "test": "vitest run --bail 1",
    "lint": "eslint ."
  },
  "dependencies": {
    "catch-unknown": "^2.0.0",
    "cheerio": "^1.0.0",
    "fast-xml-parser": "^4.5.1"
  }
}
