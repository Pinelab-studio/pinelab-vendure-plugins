{
  "name": "@pinelab/vendure-plugin-metrics",
  "version": "4.0.0",
  "description": "Vendure plugin measuring and visualizing e-commerce metrics",
  "keywords": [
    "vendure",
    "plugin",
    "metrics",
    "analytics",
    "insights",
    "dashboard",
    "charts",
    "diagrams"
  ],
  "author": "Martijn van de Brug <martijn@pinelab.studio>",
  "homepage": "https://engineering.pinelab.studio/",
  "repository": "https://github.com/Pinelab-studio/pinelab-vendure-plugins",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rimraf dist && yarn generate && tsc && copyfiles -u 1 -e 'src/**/*.spec.ts' 'src/dashboard/**/*' dist/",
    "build:dashboard": "vite build --config ./vite.config.mts",
    "test": "vitest run --bail 1",
    "start": "ts-node test/dev-server.ts",
    "dev:dashboard": "vite --clearScreen false",
    "generate": "graphql-codegen",
    "lint": "biome check ."
  },
  "dependencies": {
    "catch-unknown": "^2.0.0",
    "chart.js": "^4",
    "date-fns": "^2.29.3",
    "react-chartjs-2": "^5"
  },
  "gitHead": "476f36da3aafea41fbf21c70774a30306f1d238f"
}
